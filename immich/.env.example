# Copy to .env and adapt the paths and database password before deployment.
# Keep the paths from the existing installation when migrating this Compose file.

UPLOAD_LOCATION=./library
EXTERNAL_LIBRARY_LOCATION=/path/to/existing/photos
DB_DATA_LOCATION=./postgres
DB_PASSWORD=CHANGE_ME_ALPHANUMERIC_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# 0.0.0.0 preserves the original LAN-facing port mapping.
IMMICH_BIND=0.0.0.0
IMMICH_PORT=2283

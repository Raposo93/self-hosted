# Trusted Bash syntax. Keep this file and the checkout writable only by admins.
HOST_NAME=host-example
RECIPIENT_EMAIL=recipient@example.com
MSMTP_ACCOUNT=notifications
SENDER_EMAIL=notifications@example.com
# Empty/omitted SEND_MAIL defaults to the repository mail-notifier.
CHECK_SECURITY_UPDATES=true
CHECK_DISK_SPACE=true
DISK_WARNING=85
DISK_CRITICAL=95
DISK_MAX_DEPTH=3
# Total du budget per alerted filesystem, in seconds.
DISK_DIAG_TIMEOUT=60
CHECKER_STATE_DIR=/var/lib/self-hosted-checker

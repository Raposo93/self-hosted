LOGFILE="/var/log/pbc/backup.log"
SOURCE_DIR="/path/to/data"
# For a source on a disk or network share, set its mount point. An ordinary
# directory needs neither setting. SOURCE_DIR may be below this mount point.
# EXPECTED_MOUNT="/path/to"
# Optional exact SOURCE value from: findmnt -T /path/to/data -n -o SOURCE
# EXPECTED_MOUNT_SOURCE="server:/export"
# Optional mounted directories below SOURCE_DIR, separated by | (spaces are safe).
# INCLUDE_DEV_MOUNTS="/path/to/data/photos|/path/to/data/media"
REPO="user@realm!api_token_name@host:datastore"
BACKUP_NAME="data.pxar"
BACKUP_ID="example-profile"
# Optional PBS datastore namespace; omit or leave empty for the default namespace.
# NAMESPACE="application-backups"

RECIPIENT_EMAIL="recipient@example.com"
SENDER_EMAIL="sender@example.com"
MSMTP_ACCOUNT="default"

# Optional client-side encryption
# ENCRYPTION_KEYFILE="/root/.config/proxmox-backup/<profile>-encryption-key.json"

[Unit]
Description=Send completed weekly MikroTik blocking reports
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/path/to/self-hosted/mikrotik-report
EnvironmentFile=/path/to/self-hosted/mikrotik-report/.env
ExecStart=/usr/bin/python3 /path/to/self-hosted/mikrotik-report/mikrotik_report.py report

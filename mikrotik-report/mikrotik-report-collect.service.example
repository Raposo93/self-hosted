[Unit]
Description=Collect MikroTik blocking counters
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/path/to/self-hosted/mikrotik-report
EnvironmentFile=/path/to/self-hosted/mikrotik-report/.env
StateDirectory=mikrotik-report
ExecStart=/usr/bin/python3 /path/to/self-hosted/mikrotik-report/mikrotik_report.py collect

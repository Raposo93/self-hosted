REPO="user@realm!api_token_name@host:datastore"
RESTORE_GROUP="host/example-profile"
BACKUP_NAME="data.pxar"
# Match NAMESPACE in the backup profile; omit or leave empty for the root namespace.
# NAMESPACE="application-backups"
RESTORE_TMP_BASE="/var/tmp"
MAX_SNAPSHOT_AGE_SECONDS="604800"
RESTORE_TIMEOUT_SECONDS="3600"
SENTINEL_PATH=".pbc-restore-sentinel"
SENTINEL_CONTENT="pbc-restore-sentinel-v1"
# SENTINEL_SHA256="<64 hexadecimal characters>"
# ENCRYPTION_KEYFILE="/root/.config/proxmox-backup/<profile>-encryption-key.json"
RECIPIENT_EMAIL="recipient@example.com"
SENDER_EMAIL="sender@example.com"
MSMTP_ACCOUNT="default"
